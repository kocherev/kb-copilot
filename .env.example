# Copy to .env. Every value here is a placeholder.

# Postgres
POSTGRES_USER=kb
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=kb
DATABASE_URL=postgresql://kb:replace-me@localhost:5432/kb

# Qdrant. GET /readyz returns plain text and HTTP 200. Do not parse it as JSON.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Directory the API may read when a client sends {"directory": "..."}.
KB_DATA_ROOT=.

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web. The public URL is inlined when the web image is built.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LiveKit. Placeholders only.
# `docker compose --profile livekit up` starts livekit-server with --dev and does not read these.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Model providers. Leave empty until a later change wires a model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
