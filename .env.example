# Copy to .env. Every value here is a placeholder.

# Postgres
POSTGRES_USER=kb
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=kb
# Host port. Compose binds it to 127.0.0.1 only.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kb:replace-me@localhost:5432/kb

# Qdrant. GET /readyz returns plain text and HTTP 200. Do not parse it as JSON.
QDRANT_URL=http://localhost:6333
# Host port. Compose binds it to 127.0.0.1 only.
QDRANT_PORT=6333
QDRANT_API_KEY=

# Auth. Better Auth runs in the web app and signs JWTs. The API verifies them.
# The web app refuses to start until this is 32+ random characters:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me
# The browser-facing web URL. It is also the JWT issuer the API checks.
BETTER_AUTH_URL=http://localhost:3000
# Shared secret for service reads of GET /products/{id} (header X-Internal-Token).
# The API, the agent, and the MCP server (get_product) all read this variable.
# replace-me turns the internal route off (HTTP 503). Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-me
# Session starts allowed per org per minute, and the LiveKit token lifetime.
SESSION_RATE_LIMIT=10
LIVEKIT_TOKEN_TTL_SECONDS=900

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web. The public URL is inlined when the web image is built.
# In Compose, server-rendered pages call the API at http://api:8000 instead.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LiveKit. Placeholders only.
# Browser and host tools use LIVEKIT_URL.
# The agent container uses LIVEKIT_AGENT_URL.
# The API container dispatches the agent over LIVEKIT_API_URL.
# LiveKit Cloud: set all three URLs to wss://<project>.livekit.cloud and use that project's key pair.
# Self-hosted: `docker compose --profile livekit up`.
# The dev server uses API key devkey and API secret secret. Put those in .env.
# The dev process does not read this file.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_AGENT_URL=ws://livekit:7880
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Voice model. The agent speaks and sees the shared screen through Gemini Live
# (gemini-3.8-live-extended-thinking) on every LiveKit host. Create a key at
# https://aistudio.google.com/apikey. The worker refuses to start without it.
GOOGLE_API_KEY=replace-me
KB_VOICE=Puck
# The agent says goodbye and closes the session after this many seconds.
AGENT_MAX_SESSION_SECONDS=600

# Linear handoff. Create an OAuth2 app at https://linear.app/settings/api and set
# its callback URL to LINEAR_REDIRECT_URI (the web app's /api/integrations/linear/callback).
# The agent proposes a ticket, and a user approves it before Linear sees it.
# replace-me turns the Connect Linear control off (HTTP 503).
LINEAR_CLIENT_ID=replace-me
LINEAR_CLIENT_SECRET=replace-me
LINEAR_REDIRECT_URI=http://localhost:3000/api/integrations/linear/callback
# 32 random bytes in base64. Encrypts stored tokens and signs the OAuth state:
#   openssl rand -base64 32
LINEAR_TOKEN_KEY=replace-me
# Only for the gated live test: KB_LIVE_LINEAR=1 uv run pytest services/api/tests/test_linear_live.py
LINEAR_API_KEY=

# Judge model for `make eval-live`.
ANTHROPIC_API_KEY=
